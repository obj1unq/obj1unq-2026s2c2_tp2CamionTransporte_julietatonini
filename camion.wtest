import camion.*
import cosas.*


describe "Camion de transporte" {

    test "cargar y descargar cosas" {
        assert.that(camion.cosas().isEmpty())
        camion.cargar(bumblebee)
        assert.equals(#{bumblebee}, camion.cosas())
        camion.cargar(knightRider)
        assert.equals(#{bumblebee, knightRider}, camion.cosas())
        camion.descargar(bumblebee)
        assert.equals(#{knightRider}, camion.cosas())
        assert.throwsException({camion.cargar(knightRider)})
        assert.throwsException({camion.descargar(bumblebee)})
    }



    test "todo peso par" {
        camion.cargar(bumblebee)
        arena.peso(50)
        camion.cargar(arena)
        assert.that(camion.todoPesoPar())
    }


    test "todo peso no es par" {
        camion.cargar(bumblebee)
        arena.peso(51)
        camion.cargar(arena)
        assert.notThat(camion.todoPesoPar())
    }



    test "hay alguno que pesa" {
        camion.cargar(bumblebee)
        arena.peso(50)
        camion.cargar(arena)
        assert.that(camion.algunoQuePesa(50))
        assert.that(camion.algunoQuePesa(800))
        assert.notThat(camion.algunoQuePesa(500))
    }



    test "el camion no esta excedido de peso" {
        camion.cargar(bumblebee)
        paqueteLadrillos.cantidadLadrillos(300)
        camion.cargar(paqueteLadrillos)
        assert.notThat(camion.estaExcedido())
    }


    test "el camion esta excedido de peso" {
        camion.cargar(bumblebee)
        paqueteLadrillos.cantidadLadrillos(400)
        camion.cargar(paqueteLadrillos)
        assert.that(camion.estaExcedido())
    }


    test "el de nivel"{
        bumblebee.actualizarEstado(auto)
        camion.cargar(bumblebee)
        bateriaAntiaerea.actualizarMisiles()
        camion.cargar(bateriaAntiaerea)
        camion.cargar(residuos)
        assert.equals(bateriaAntiaerea, camion.cargaDeNivel(0))
        assert.equals(bumblebee, camion.cargaDeNivel(15))
        assert.equals(residuos, camion.cargaDeNivel(200))
        assert.throwsException({camion.cargaDeNivel(30)})
        bumblebee.actualizarEstado(robot)
        assert.equals(bumblebee, camion.cargaDeNivel(30))
        bateriaAntiaerea.actualizarMisiles()
        assert.equals(bateriaAntiaerea, camion.cargaDeNivel(100))
    }



    test "cosas peligrosas"{
        camion.cargar(knightRider)
        camion.cargar(bateriaAntiaerea)
        assert.equals(#{bateriaAntiaerea}, camion.conExcesoDePeligrosidad(15))
        assert.equals(#{bateriaAntiaerea}, camion.masPeligrosasQue(bumblebee))
        assert.equals(#{knightRider, bateriaAntiaerea}, camion.conExcesoDePeligrosidad(2))
        assert.equals(#{knightRider, bateriaAntiaerea}, camion.masPeligrosasQue(paqueteLadrillos))
        assert.equals(#{}, camion.conExcesoDePeligrosidad(200))
        assert.equals(#{}, camion.masPeligrosasQue(residuos))
    }



    test "puede circular en ruta"{
        camion.cargar(bumblebee)
        paqueteLadrillos.cantidadLadrillos(300)
        camion.cargar(paqueteLadrillos)
        assert.that(camion.puedeCircular(20))
    }



    test "no puede circular en ruta"{
        paqueteLadrillos.cantidadLadrillos(400)
        camion.cargar(paqueteLadrillos)
        camion.cargar(bumblebee)
        assert.notThat(camion.puedeCircular(20))
    }



    test "no puede circular en ruta 2"{
        paqueteLadrillos.cantidadLadrillos(300)
        camion.cargar(paqueteLadrillos)
        bumblebee.actualizarEstado(robot)
        camion.cargar(bumblebee)
        assert.notThat(camion.puedeCircular(20))
    }
}